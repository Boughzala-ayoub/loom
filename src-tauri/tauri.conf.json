{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loom",
  "version": "3.0.0",
  "identifier": "dev.ayoub.loom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Loom",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": true,
        "create": false,
        "backgroundColor": "#0a0f1b"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": "default-src 'self' 'unsafe-inline' ws: http://localhost:1420 ipc: http://ipc.localhost blob: data:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "./nsis-hooks.nsi"
      }
    },
    "publisher": "Loom",
    "shortDescription": "Multi-folder agentic terminal workspace",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
