{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loom",
  "version": "3.0.0",
  "identifier": "dev.ayoub.loom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Loom",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": true,
        "create": false,
        "backgroundColor": "#0a0f1b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "./nsis-hooks.nsi"
      }
    },
    "publisher": "Loom",
    "shortDescription": "Multi-folder agentic terminal workspace",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
